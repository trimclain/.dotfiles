#!/usr/bin/env bash

# Install latest Maple Mono Release
#
# Reason: all AUR packages are bad
# Requires: curl, unzip, fc-cache (fontconfig)

FONT_DIR="$HOME/.local/share/fonts"
API_URL="https://api.github.com/repos/subframe7536/maple-font/releases/latest"
RELEASE_URL="https://github.com/subframe7536/maple-font/releases"
# Use hinted for low-resolution displays and small font sizes
# Docs: https://github.com/subframe7536/maple-font/blob/variable/documentation/choose.md
#ARCHIVE_NAME="MapleMono-NF-unhinted.zip"
ARCHIVE_NAME="MapleMono-NF.zip"
INSTALLED_NAME="$FONT_DIR/MapleMono-NF"

INSTALLED_VERSION="none"

main() {
    if [[ -f "$INSTALLED_NAME/config.json" ]]; then
        INSTALLED_VERSION=$(awk -F'"' '/"version"/ {print $4; exit}' "$INSTALLED_NAME/config.json")
    fi

    LATEST_VERSION=$(curl -s "$API_URL" | awk -F'"' '/"tag_name":/ { print $4; exit }')

    echo "========================================"
    echo "          Maple Mono Nerd Font          "
    echo "========================================"
    echo
    echo "Installed version: $INSTALLED_VERSION"
    echo "Latest version:    $LATEST_VERSION"
    echo

    read -r -n 1 -p "Do you want to (re)install? [Y/n] " answer
    echo

    if [[ -n "$answer" && ! "$answer" =~ ^[Yy]$ ]]; then
        echo "Installation cancelled."
        exit 0
    fi

    echo "Installing $LATEST_VERSION..."

    pushd /tmp > /dev/null || exit

    OPTS=("--location" "--remote-header-name" "--remote-name" "--progress-bar")
    curl "${OPTS[@]}" "$RELEASE_URL/download/$LATEST_VERSION/$ARCHIVE_NAME"

    rm -rf "$INSTALLED_NAME"
    mkdir -p "$INSTALLED_NAME"
    unzip "$ARCHIVE_NAME" -d "$INSTALLED_NAME"
    rm -f "$ARCHIVE_NAME"

    popd > /dev/null || exit

    echo "Done"

    fc-cache
}

main "$@"
