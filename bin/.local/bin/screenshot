#!/usr/bin/env bash

###############################################################################
# Screenshot Tool
#
# Description: Take screenshot of entire screen or selected region
# and save it to clipboard
# Dependencies:
#   on X11: maim, slop, satty or xclip
#   on Wayland: grim, slurp, swappy or wl-copy
###############################################################################

# Make sure dependencies are installed
ensure_installed() {
    if ! command -v "$1" > /dev/null; then
        echo "Error: $1 not found"
        exit 1
    fi
}

notify() {
    if command -v dunstify > /dev/null; then
        dunstify -a "screenshot" -u low -t 2000 "Screenshot" "$1 saved to clipboard"
    else
        notify-send "Screenshot" "$1 saved to clipboard" -t 2000
    fi
}

# Show help if no argument is passed
show_help() {
    echo "Usage: screenshot [screen|region]"
    echo "screen: screenshot entire screen"
    echo "region: screenshot selected window"
}

##########################################
# Screenshot full screen to clipboard
##########################################
screen() {
    if [ -n "$WAYLAND_DISPLAY" ]; then
        ensure_installed grim
        if command -v swappy > /dev/null; then
            grim - | swappy -f -
        else
            grim - | wl-copy
            notify "Screen"
        fi
    else
        ensure_installed maim
        ensure_installed xclip
        # INFO: satty works on wayland as well, just update the copy-command
        if command -v satty > /dev/null; then
            maim | satty \
                --filename - \
                --copy-command 'xclip -selection clipboard -t image/png -i' \
                --actions-on-enter save-to-clipboard \
                --early-exit \
                --fullscreen \
                &> /dev/null
        else
            maim | xclip -selection clipboard -t image/png
            notify "Screen"
        fi
    fi
}

##########################################
# Screenshot selected region to clipboard
##########################################
region() {
    if [ -n "$WAYLAND_DISPLAY" ]; then
        ensure_installed grim
        ensure_installed slurp
        REGION=$(slurp 2> /dev/null)
        if [ -z "$REGION" ]; then
            exit
        fi
        if command -v swappy > /dev/null; then
            grim -g "$REGION" - | swappy -f -
        else
            grim -g "$REGION" - | wl-copy
            notify "Region"
        fi
    else
        ensure_installed maim
        ensure_installed slop
        ensure_installed xclip
        if command -v satty > /dev/null; then
            maim -s | satty \
                --filename - \
                --copy-command 'xclip -selection clipboard -t image/png -i' \
                --actions-on-enter save-to-clipboard \
                --early-exit \
                --floating-hack \
                &> /dev/null
        else
            maim -s | xclip -selection clipboard -t image/png
            notify "Region"
        fi
    fi
}

case "$1" in
    screen) screen ;;
    region) region ;;
    *) show_help ;;
esac
