#!/usr/bin/env bash

# Script to clean pacman and paru cache
# Requirements: paccache command from pacman-contrib package

# readonly GREEN="\033[32m"
readonly YELLOW="\033[33m"
readonly MAGENTA="\033[35m"
readonly CYAN="\033[36m"
readonly RESET="\033[0m"

readonly AUR_CACHE_DIR="$HOME/.cache/paru/clone"

VERBOSE='false'
DRY_RUN='false'

# NOTE: paru -Scc exists, but its full cache purge is not an alternative to selective version retention.
if ! command -v paccache > /dev/null; then
    echo "Command 'paccache' not found. Please install pacman-contrib."
    exit 1
fi

inform() {
    echo -e "\n${MAGENTA}$1${RESET}: ${CYAN}$2${RESET} - keeping $3"
}

show_help() {
    echo "Usage: paccache-clear [OPTIONS]"
    echo ""
    echo "A simple script to clean pacman and paru cache."
    echo ""
    echo "Options:"
    echo "  -h             Display this help message."
    echo "  -v             Enable verbose output."
    echo "  -d             Perform a dry run."
}

while getopts ":hvd" opt; do
    case "$opt" in
        h) show_help && exit 0 ;;
        v) VERBOSE='true' ;;
        d) DRY_RUN='true' ;;
        \?)
            echo "Error: Invalid option -$OPTARG" >&2
            exit 1
            ;;
    esac
done
shift $((OPTIND - 1))
readonly VERBOSE DRY_RUN

# DRY_RUN toggle
PACCACHE_FLAGS=()
if [[ "$DRY_RUN" == "true" ]]; then
    PACCACHE_FLAGS+=(-d)
else
    PACCACHE_FLAGS+=(-r)
fi

# VERBOSE toggle
if [[ "$VERBOSE" == "true" ]]; then
    PACCACHE_FLAGS+=(-v)
fi

inform "UNINSTALLED PACKAGES" "AUR" "0 versions"
AUR_CACHE_REMOVED=()
if [[ -d "$AUR_CACHE_DIR" ]]; then
    mapfile -d '' -t AUR_CACHE_REMOVED < <(
        find "$AUR_CACHE_DIR" -mindepth 1 -maxdepth 1 -type d -printf '-c\0%p\0'
    )
fi

# Clean package archives only when AUR cache directories were found.
if ((${#AUR_CACHE_REMOVED[@]} > 0)); then
    if [[ "$DRY_RUN" == "true" ]]; then
        paccache -duvk0 "${AUR_CACHE_REMOVED[@]}" || exit "$?"
    else
        paccache -ruvk0 "${AUR_CACHE_REMOVED[@]}" || exit "$?"
    fi
fi

# Independently remove empty immediate child directories.
if [[ -d "$AUR_CACHE_DIR" ]]; then
    while IFS= read -r -d '' dir; do
        if [[ "$DRY_RUN" == "true" ]]; then
            printf '%bWARNING:%b would remove currently empty directory: %s\n' "$YELLOW" "$RESET" "$dir"
        else
            printf '%bWARNING:%b removing empty directory: %s\n' "$YELLOW" "$RESET" "$dir"
            rmdir --ignore-fail-on-non-empty -- "$dir" || exit "$?"
        fi
    done < <(
        find "$AUR_CACHE_DIR" -mindepth 1 -maxdepth 1 -type d -empty -print0
    )
fi

inform "UNINSTALLED PACKAGES" "PACMAN" "1 version"
paccache "${PACCACHE_FLAGS[@]}" -uk1 || exit "$?"

inform "INSTALLED PACKAGES" "PACMAN+AUR" "2 versions"
AUR_CACHE=()
if [[ -d "$AUR_CACHE_DIR" ]]; then
    mapfile -d '' -t AUR_CACHE < <(
        find "$AUR_CACHE_DIR" -mindepth 1 -maxdepth 1 -type d -printf '-c\0%p\0'
    )
fi
paccache "${PACCACHE_FLAGS[@]}" -k2 -c /var/cache/pacman/pkg "${AUR_CACHE[@]}"
