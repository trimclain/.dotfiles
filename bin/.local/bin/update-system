#!/usr/bin/env bash

section() {
    local title="$1"
    local width=80
    local padding left right left_fill right_fill heading

    # Leave at least three '=' characters on each side.
    (( width < ${#title} + 8 )) && width=$(( ${#title} + 8 ))

    padding=$(( width - ${#title} - 2 ))
    left=$(( padding / 2 ))
    right=$(( padding - left ))

    printf -v left_fill '%*s' "$left" ''
    printf -v right_fill '%*s' "$right" ''
    printf -v heading '%s %s %s' \
        "${left_fill// /=}" "$title" "${right_fill// /=}"

    if [[ -t 1 && -z ${NO_COLOR+x} ]]; then
        printf '\n\033[1;36m%s\033[0m\n\n' "$heading"
    else
        printf '\n%s\n\n' "$heading"
    fi
}

if [[ -n "${TERMUX_VERSION:-}" || "${PREFIX:-}" == */com.termux/files/usr ]]; then
    OS=termux
else
    OS=$(awk -F= '$1=="ID" { gsub(/"/, "", $2); print $2; }' /etc/os-release 2> /dev/null)
    DISTRO_ID=$OS

    case "$OS" in
        debian | ubuntu | linuxmint)
            OS=ubuntu
            ;;
        arch | manjaro | endeavouros | endevouros | garuda | cachyos)
            OS=arch
            ;;
    esac
fi

PKGMGR_CONFIRM=''
DASH_Y_CONFIRM=''

if (($# > 1)); then
    printf 'Error: expected at most one argument.\nUsage: update-system [flag]\n' >&2
    exit 1
fi

if [[ -n ${1:-} ]]; then
    if [[ $1 == "--help" || $1 == "-h" ]]; then
        echo "Update the system packages and clean up unused packages."
        echo ""
        echo "Usage: update-system [flag]"
        echo "Flags:"
        echo "  --help, -h   Show this help message"
        echo "  --yes, -y    Autoconfirm all updates"
        echo "  -m, -r       Use reflector to update the pacman mirrorlist"
        exit 0
    fi

    if [[ $1 == "-m" || $1 == "-r" ]]; then
        if [[ "${DISTRO_ID:-}" != arch ]]; then
            echo "Error: mirror refresh is configured only for Arch Linux." >&2
            exit 1
        fi

        section "Updating pacman mirror list"
        if sudo reflector --protocol https --latest 20 --sort rate --save /etc/pacman.d/mirrorlist; then
            echo "Done"
        else
            echo "Failed to update pacman mirror list." >&2
            exit 1
        fi

        exit 0
    fi

    if [[ $1 == "--yes" || $1 == "-y" ]]; then
        if [[ $OS == arch ]]; then
            PKGMGR_CONFIRM='--noconfirm'
        else
            PKGMGR_CONFIRM='-y'
        fi
        DASH_Y_CONFIRM='-y'
    else
        printf 'Error: unknown argument: %s\n' "$1" >&2
        exit 1
    fi
fi

# Package manager updates
if [[ $OS == termux ]]; then
    section "Updating system packages"
    pkg upgrade $PKGMGR_CONFIRM || exit "$?"

    section "Cleaning package cache"
    apt autoclean $PKGMGR_CONFIRM

    section "Removing unused packages"
    apt autoremove $PKGMGR_CONFIRM
elif [[ $OS == ubuntu ]]; then
    section "Refreshing package lists"
    sudo apt update || exit "$?"

    section "Updating system packages"
    sudo apt upgrade $PKGMGR_CONFIRM || exit "$?"

    section "Cleaning package cache"
    sudo apt autoclean $PKGMGR_CONFIRM

    section "Removing unused packages"
    sudo apt autoremove $PKGMGR_CONFIRM
elif [[ $OS == arch ]]; then
    section "Updating system packages"
    if command -v paru > /dev/null; then
        paru -Syu $PKGMGR_CONFIRM || exit "$?"
    else
        sudo pacman -Syu $PKGMGR_CONFIRM || exit "$?"
    fi

    section "Removing orphaned packages"
    count=0
    while true; do
        ((count++))
        # -Qdtq: Query, dependencies, not required by others, package names only
        orphans=$(pacman -Qdtq)

        if [[ -z "$orphans" ]]; then
            if [[ $count -le 1 ]]; then
                echo "No orphaned packages found. Exiting."
            else
                echo "No more orphaned packages found. Exiting."
            fi
            break
        else
            # shellcheck disable=SC2086
            sudo pacman -Rns $orphans $PKGMGR_CONFIRM || break
            # Add a small delay to prevent rapid looping if pacman is very fast
            # and new orphans appear immediately after removal (unlikely but good practice)
            sleep 1
        fi
    done

    if command -v paccache-clear > /dev/null && command -v paccache > /dev/null; then
        section "Cleaning pacman and Paru caches"
        paccache-clear
    fi
else
    echo "Error: OS not supported"
    exit 1
fi

# Flatpak
if command -v flatpak > /dev/null; then
    section "Updating Flatpak apps"
    flatpak update $DASH_Y_CONFIRM || exit "$?"

    section "Removing unused Flatpak runtimes"
    while true; do
        before=$(flatpak list --columns=installation,ref) || break
        flatpak uninstall --unused $DASH_Y_CONFIRM || break
        after=$(flatpak list --columns=installation,ref) || break
        if [[ "$before" == "$after" ]]; then
            break
        fi
    done
fi

# Rustup
if command -v rustup > /dev/null; then
    section "Updating Rust toolchains"
    rustup update
fi

# Mise
if command -v mise > /dev/null; then
    section "Updating mise tools"
    mise up $DASH_Y_CONFIRM || exit "$?"

    section "Pruning unused mise versions"
    mise prune $DASH_Y_CONFIRM
fi

# Getnf
if command -v getnf > /dev/null; then
    section "Updating Nerd Fonts"
    getnf -U
fi
